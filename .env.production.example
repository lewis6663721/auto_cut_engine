APP_ENV=production
AUTOCUT_HOST_PORT=18080

# Database inside docker-compose network
MYSQL_DATABASE=ai_studio
MYSQL_ROOT_PASSWORD=change-this-root-password
DATABASE_URL=mysql://root:change-this-root-password@mysql:3306/ai_studio
MYSQL_URL=mysql://root:change-this-root-password@mysql:3306/ai_studio

# Redis / Celery inside docker-compose network
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_ALWAYS_EAGER=false
USE_CELERY=true

# Security
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Media Storage
MEDIA_ROOT=/app/media

# AI
DASHSCOPE_API_KEY=
TRANSFER_API_KEY=
AI_BASE_URL=https://api.aifoxspa.com
AI_MODEL=gpt-5.4-mini
AI_REMOTE_ENABLED=true
