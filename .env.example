# Database
DATABASE_URL=mysql://root:your-local-password@localhost:3306/ai_studio
# Legacy README-compatible alias:
MYSQL_URL=mysql://root:your-local-password@localhost:3306/ai_studio

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_ALWAYS_EAGER=false
USE_CELERY=false

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Media Storage
MEDIA_ROOT=./media

# AI
DASHSCOPE_API_KEY=
TRANSFER_API_KEY=
AI_BASE_URL=https://api.aifoxspa.com
AI_MODEL=gpt-5.4-mini
AI_REMOTE_ENABLED=true
